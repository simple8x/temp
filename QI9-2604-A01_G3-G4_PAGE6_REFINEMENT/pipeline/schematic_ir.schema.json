{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schematic-ir-v1.schema.json",
  "title": "Evidence-first SchematicIR",
  "type": "object",
  "required": ["schema", "source_sha256", "objects", "nets", "status"],
  "properties": {
    "schema": {"const": "schematic-ir/v1"},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "objects": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "status", "evidence"], "properties": {
      "id": {"type": "string"}, "kind": {"enum": ["symbol", "pin", "wire", "label", "junction", "text"]},
      "reference": {"type": ["string", "null"]}, "value": {"type": ["string", "null"]},
      "status": {"enum": ["VERIFIED", "INFERRED", "UNRESOLVED", "REJECTED"]},
      "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
      "evidence": {"type": "array", "items": {"type": "object", "required": ["source_page", "source_region", "evidence_type"], "properties": {
        "source_page": {"type": "integer", "minimum": 1}, "source_region": {"type": "string"},
        "evidence_type": {"enum": ["VECTOR_GEOMETRY", "NATIVE_TEXT", "OCR_CANDIDATE", "MANUAL_REVIEW"]},
        "artifact": {"type": ["string", "null"]}, "bbox": {"type": ["array", "null"]}
      }}}
    }}},
    "nets": {"type": "array", "items": {"type": "object", "required": ["id", "status", "members", "evidence"], "properties": {
      "id": {"type": "string"}, "name": {"type": ["string", "null"]},
      "status": {"enum": ["VERIFIED", "INFERRED", "UNRESOLVED"]},
      "members": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array"}
    }}},
    "status": {"enum": ["DRAFT", "BLOCKED_PENDING_REVIEW", "VERIFIED"]}
  }
}
